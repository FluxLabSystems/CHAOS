# Project CHAOS -- deployment environment template.
#
#   cp deploy/.env.example deploy/.env
#   # then replace every CHANGE_ME with a value generated on this property
#
# deploy/.env is gitignored (see .gitignore: `.env`). NEVER commit real secrets.
#
# SDD section 15.2 requires per-device and per-service credentials: unique
# identities, not one shared homestead password. A single reused secret turns
# one compromised ESP32 in a greenhouse into broker-wide command authority.
# Generate values with, for example:
#
#   openssl rand -base64 30
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Every CHAOS_* variable here maps 1:1 onto a field of
# src/chaos/config.py (env_prefix = CHAOS_).

# ---------------------------------------------------------------------------
# Exposure
# ---------------------------------------------------------------------------
# Which host address the published ports bind to. Loopback by default: the
# firewall, not Docker, decides who reaches these services (SDD 15.1 is
# deny-by-default). Set to a VLAN 20 interface address once the addressing plan
# exists -- the asset register deliberately leaves host addressing TBD.
BIND_ADDRESS=127.0.0.1
TZ=America/Toronto

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
POSTGRES_USER=homestead
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=homestead
POSTGRES_PORT=5432

# Optional: a separate, read-only role for Grafana. Create it in psql, then
# point Grafana at it. Grafana should not hold the owner credentials.
#   CREATE ROLE grafana_ro LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE homestead TO grafana_ro;
#   GRANT USAGE ON SCHEMA public TO grafana_ro;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO grafana_ro;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO grafana_ro;
# GRAFANA_PG_USER=grafana_ro
# GRAFANA_PG_PASSWORD=CHANGE_ME_grafana_readonly_password

# ---------------------------------------------------------------------------
# MQTT (Mosquitto)
# ---------------------------------------------------------------------------
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# The twin core's own broker identity. Distinct from every gateway identity.
CHAOS_MQTT_USERNAME=svc-twin-primary
CHAOS_MQTT_PASSWORD=CHANGE_ME_twin_mqtt_password
CHAOS_MQTT_TLS=false
# The port the twin dials on the compose network: 1883 while the broker
# serves plaintext, 8883 once its TLS listener is enabled. (MQTT_PORT above is
# the port published on the host; this one is inside the network.)
CHAOS_MQTT_PORT=1883
# TLS material for the broker connection (deploy/mosquitto/README.md, "Enabling
# TLS"). The CA bundle is what lets the platform verify a broker certificate
# issued by the property's private CA; the client certificate and key are for
# the later step where the broker requires one. Paths as the twin container
# sees them: SECRETS_DIR on the host (relative to deploy/) is mounted
# read-only at /run/secrets in the twin container, so put the files there.
# Verification is never relaxed unless CHAOS_MQTT_TLS_INSECURE=true is set
# explicitly, which is logged and is for a bench only.
SECRETS_DIR=./secrets
# CHAOS_MQTT_TLS_CA=/run/secrets/mqtt-ca.crt
# CHAOS_MQTT_TLS_CERT=/run/secrets/twin-client.crt
# CHAOS_MQTT_TLS_KEY=/run/secrets/twin-client.key
# CHAOS_MQTT_TLS_INSECURE=false
CHAOS_MQTT_BASE_TOPIC=homestead
CHAOS_MQTT_ENABLED=true

# Optional least-privilege identity used only by the broker healthcheck. It needs
# read access to $SYS/broker/uptime and nothing else (see deploy/mosquitto/acl.example).
# Leave unset and the healthcheck falls back to checking that the broker process
# is alive -- weaker, but it does not report unhealthy just because anonymous
# access is correctly refused.
# MQTT_HEALTH_USER=svc-healthcheck
# MQTT_HEALTH_PASSWORD=CHANGE_ME_healthcheck_password

# ---------------------------------------------------------------------------
# Digital twin core
# ---------------------------------------------------------------------------
TWIN_IMAGE=chaos:local
TWIN_PORT=8000
CHAOS_SITE_ID=site.site.primary.01
# sql (the relational historian table) or none (current state only). Nothing
# else exists; the InfluxDB-versus-TimescaleDB decision is open.
CHAOS_HISTORIAN_BACKEND=sql
CHAOS_HISTORIAN_RAW_RETENTION_DAYS=90
# A point nobody refreshes stops presenting itself as good after this many
# seconds (unless the point or its binding says otherwise).
# CHAOS_DEFAULT_STALE_AFTER_S=60
# Commands that cannot be delivered expire rather than queue forever.
# CHAOS_COMMAND_DEFAULT_TTL_S=300
CHAOS_EMS_ENABLED=true
# CHAOS_EMS_TICK_INTERVAL_S=5
# Optional EMS override file (YAML or JSON), as the twin container sees it;
# mount it read-only (see the commented volume in docker-compose.yml). Every
# effective change is recorded as a configuration revision (docs/ems-configuration.md).
# CHAOS_EMS_CONFIG_FILE=/app/config/ems-config.yaml
CHAOS_ALARM_ENGINE_ENABLED=true
# Comma separated: log,email,push,voice. A channel named here without its
# settings records not_configured on every attempt, naming what is missing.
CHAOS_NOTIFICATION_BACKENDS=log
# Email: an SMTP relay on the property network (SDD 5.1 local-first).
# Recipients per escalation role, role=addr,addr;role=addr. The roles are the
# ones data/alarm_definitions.yaml escalates to: operator, on_call, maintainer.
# CHAOS_NOTIFY_SMTP_HOST=relay.lan
# CHAOS_NOTIFY_SMTP_PORT=587
# CHAOS_NOTIFY_SMTP_SECURITY=starttls
# CHAOS_NOTIFY_SMTP_USERNAME=svc-chaos-mail
# CHAOS_NOTIFY_SMTP_PASSWORD=CHANGE_ME_smtp_password
# CHAOS_NOTIFY_SMTP_FROM=chaos@homestead.lan
# CHAOS_NOTIFY_SMTP_TIMEOUT_S=10.0
# CHAOS_NOTIFY_EMAIL_RECIPIENTS=operator=ops@homestead.lan;on_call=duty@homestead.lan;maintainer=tech@homestead.lan
# Push: a self-hosted, ntfy-compatible server on the property network. One
# JSON POST per topic: {"topic","title","message","priority","tags"}.
# CHAOS_NOTIFY_PUSH_URL=https://ntfy.lan/
# CHAOS_NOTIFY_PUSH_TOKEN=CHANGE_ME_push_token
# CHAOS_NOTIFY_PUSH_TARGETS=operator=chaos-operator;on_call=chaos-on-call;maintainer=chaos-maintainer
# CHAOS_NOTIFY_PUSH_TIMEOUT_S=10.0
# A failed delivery is retried on later alarm-engine cycles, bounded.
# CHAOS_NOTIFY_RETRY_LIMIT=3
# CHAOS_NOTIFY_RETRY_INTERVAL_S=300

# Freeze/heat risk on the property overview, derived from the site's outside
# air temperature. Commissioning defaults, not agronomic decisions.
# CHAOS_OVERVIEW_FREEZE_RISK_C=2.0
# CHAOS_OVERVIEW_HEAT_RISK_C=32.0

# Where `chaos backup` writes by default and where the backup-age monitor
# reads the newest archive's manifest to publish backup_age_h (the point the
# shipped backup_overdue alarm watches). Inside the twin-var volume; the
# fuller deploy/backup/backup.sh set copies archives out from here.
# CHAOS_BACKUP_DIRECTORY=/app/var/backups
# The asset backup_age_h is published for. The shipped alarm watches the
# platform's database service.
# CHAOS_BACKUP_AGE_ASSET_ID=it.application_service.rack_01.postgres_01
# The register asset that stands for this platform instance: the bus registers
# a retained offline last will on its availability topic and publishes online
# on connect, which is what lets service_unavailable fire for the API itself.
# Empty means the primary's shipped asset (digital_twin_api_01).
# CHAOS_PLATFORM_ASSET_ID=

# The API's title and root path (behind a path-prefixing reverse proxy).
# CHAOS_API_TITLE=Project CHAOS API
# CHAOS_API_ROOT_PATH=
# Log every SQL statement. Debugging only.
# CHAOS_SQL_ECHO=false
# POST /_supervisor/stop exists only while this is set. It is the Windows
# process supervisor's graceful stop; a container has no supervisor and no
# reason to set it.
# CHAOS_SUPERVISOR_STOP_SECRET=

# THE SAFETY GATE.
# Leave false until the subsystem being controlled has passed all twelve steps
# of the SDD section 19 commissioning sequence and its commissioning record is
# in the registry. See docs/commissioning.md.
CHAOS_ALLOW_PHYSICAL_CONTROL=false

# ---------------------------------------------------------------------------
# Plugins (third-party integrations) -- see docs/plugins.md
# ---------------------------------------------------------------------------
# "*" loads every plugin found. Name plugins explicitly to load only those.
CHAOS_PLUGINS_ENABLED=*
# Always wins over the enabled list. One line here takes a misbehaving vendor
# integration out of the platform without a rebuild or a code change.
CHAOS_PLUGINS_DISABLED=
# The mirror engine turns plugin readings into canonical telemetry on the bus.
CHAOS_PLUGIN_MIRROR_ENABLED=true

# Per-plugin options are CHAOS_PLUGIN_<NAME>_<KEY>. Credentials belong here and
# not in CHAOS_PLUGIN_OPTIONS, and they are never logged, returned by the API or
# printed by the CLI -- only the key names are. CHAOS_PLUGIN_OPTIONS is a JSON
# object keyed by plugin name for non-secret options, e.g.
# {"netbotz": {"enclosure_id": "nbrk0550-01"}}; a per-key variable wins over it.
# CHAOS_PLUGIN_OPTIONS=
#
# The shipped NetBotz plugin (APC environmental monitoring, SDD FR-800). The
# http transport reads a NetBotz 5.x appliance's REST API over verified TLS;
# snmp is not implemented and says so. NetBotz management sits on VLAN 10
# (SDD 15.3). The readings operation is deliberately not defaulted: open
# https://<host>/docs/rest on the appliance and set READINGS_PATH to the
# operation that lists sensor values (docs/plugins.md, section 6).
# CHAOS_PLUGIN_NETBOTZ_TRANSPORT=http
# CHAOS_PLUGIN_NETBOTZ_HOST=10.10.10.40
# CHAOS_PLUGIN_NETBOTZ_USERNAME=svc-chaos-readonly
# CHAOS_PLUGIN_NETBOTZ_PASSWORD=CHANGE_ME_netbotz_password
# CHAOS_PLUGIN_NETBOTZ_CA_FILE=/run/secrets/netbotz-ca.crt
# CHAOS_PLUGIN_NETBOTZ_READINGS_PATH=
# CHAOS_PLUGIN_NETBOTZ_ENCLOSURE_ID=nbrk0550-01
# CHAOS_PLUGIN_NETBOTZ_POLL_INTERVAL_S=30

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# ---------------------------------------------------------------------------
# Secondary control node (deploy/docker-compose.secondary.yml)
#
# This node lives in a different structure and is a different trust subject.
# Its secrets MUST differ from the primary's: if the power container burns, the
# credentials inside it should be assumed readable, not still valid elsewhere.
# ---------------------------------------------------------------------------
SECONDARY_BIND_ADDRESS=127.0.0.1
SECONDARY_POSTGRES_PASSWORD=CHANGE_ME_different_from_primary
SECONDARY_POSTGRES_PORT=5432
SECONDARY_MQTT_PORT=1883
SECONDARY_MQTT_TLS_PORT=8883
SECONDARY_MQTT_USERNAME=svc-twin-secondary
SECONDARY_MQTT_PASSWORD=CHANGE_ME_secondary_mqtt_password
# SECONDARY_MQTT_HEALTH_USER=svc-healthcheck
# SECONDARY_MQTT_HEALTH_PASSWORD=CHANGE_ME_secondary_healthcheck_password
SECONDARY_TWIN_PORT=8000
SECONDARY_GRAFANA_PORT=3000
SECONDARY_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_secondary_grafana_password
SECONDARY_RAW_RETENTION_DAYS=14
SECONDARY_NOTIFICATION_BACKENDS=log
# The relay host, recipients, push server and targets are site-wide and come
# from the CHAOS_NOTIFY_* values above. The credentials are this node's own.
# SECONDARY_NOTIFY_SMTP_USERNAME=svc-chaos-mail-secondary
# SECONDARY_NOTIFY_SMTP_PASSWORD=CHANGE_ME_secondary_smtp_password
# SECONDARY_NOTIFY_PUSH_TOKEN=CHANGE_ME_secondary_push_token
# Plugins whose manifest allows the secondary role load there too. Environmental
# monitoring is exactly what that node is for: the NetBotz 500 is mounted in the
# container the secondary node exists to outlive. The appliance and its CA are
# the CHAOS_PLUGIN_NETBOTZ_* values above; the account is this node's own.
SECONDARY_PLUGINS_ENABLED=*
SECONDARY_PLUGINS_DISABLED=
SECONDARY_PLUGIN_MIRROR_ENABLED=true
# SECONDARY_PLUGIN_OPTIONS=
# SECONDARY_PLUGIN_NETBOTZ_USERNAME=svc-chaos-readonly-secondary
# SECONDARY_PLUGIN_NETBOTZ_PASSWORD=CHANGE_ME_secondary_netbotz_password
# SECONDARY_BACKUP_DIRECTORY=/app/var/backups
# The register has no asset for the secondary node's API service yet; set this
# once one exists and the node will announce its availability like the primary.
# SECONDARY_PLATFORM_ASSET_ID=
# SECONDARY_SUPERVISOR_STOP_SECRET=
# The secondary stack ships no Prometheus; this is only the placeholder the
# provisioned datasource points at.
# SECONDARY_PROMETHEUS_URL=http://prometheus.invalid:9090

# ---------------------------------------------------------------------------
# Backups (deploy/backup/backup.sh)
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/homestead
BACKUP_KEEP_DAYS=30
# Paths to Node-RED and Home Assistant configuration on this host, if deployed.
# Both are named in SDD 8.3/8.4 and MVP acceptance criterion 5, but neither is
# part of this compose stack yet -- see docs/architecture.md.
# NODE_RED_DIR=/srv/node-red
# HOME_ASSISTANT_DIR=/srv/homeassistant
# Offsite/offline copy target. Must not be a filesystem inside the power
# container (SDD 16.1 mitigation 3).
# BACKUP_OFFSITE_TARGET=user@backup-host:/srv/homestead-backups
