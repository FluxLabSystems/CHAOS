<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Chaos.Host - the .NET gateway for Project CHAOS.

    Targets $(ChaosTargetFramework) (net10.0) from windows/Directory.Build.props.
    Deliberately NOT a Windows-specific TFM: this project is developed and
    tested on Linux and deployed on Windows, and the Windows Service
    integration is a runtime-guarded call rather than a build target. The
    WinUI shell owns the windows-specific TFM.

    LangVersion / Nullable / TreatWarningsAsErrors / Version /
    ChaosPlatformVersion are inherited from Directory.Build.props and
    deliberately not repeated here.
  -->

  <PropertyGroup>
    <TargetFramework>$(ChaosTargetFramework)</TargetFramework>
    <AssemblyName>Chaos.Host</AssemblyName>
    <RootNamespace>Chaos.Host</RootNamespace>
    <!-- The public surface of this assembly is a contract other agents code
         against, so an undocumented public member is a build error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surface the platform version contract from Directory.Build.props into
         the assembly so /host/info can report it without a second source of
         truth. -->
    <AssemblyMetadata Include="ChaosPlatformVersion" Value="$(ChaosPlatformVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!--
    The supervisor is a direct reference: the gateway registers it from
    AddChaosHost (AddChaosBackendSupervisor), first-run setup reuses its
    IProcessLauncher / IPythonRuntimeResolver so setup and the backend always
    run against the same interpreter, and Program.cs parses the service-control
    flags it owns. Both projects consume the IBackendSupervisor contract from
    Chaos.Host.Abstractions, so there is exactly one definition of it and the
    DI container cannot hold two interfaces of the same name.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Chaos.Host.Abstractions\Chaos.Host.Abstractions.csproj" />
    <ProjectReference Include="..\Chaos.Host.Supervisor\Chaos.Host.Supervisor.csproj" />

    <!-- The ported endpoints. Registered and mapped by the composition root, but
         NOT owned by default: the route-ownership manifest still sends
         /api/v1/annunciator to Python. Building and mapping them is what makes
         the migration seam real - flipping ownership becomes a configuration
         change rather than a code change. -->
    <ProjectReference Include="..\Chaos.Api\Chaos.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chaos.Host.Tests" />
  </ItemGroup>

</Project>
